# Correo con el que salen los tickets. El cliente solo escribe su dirección en el ticket.
# Gmail, Outlook y Hotmail usan su servidor según el dominio. La contraseña es de aplicación.
LCDS_SMTP_USER=
LCDS_SMTP_PASS=
LCDS_SMTP_FROM=

# Solo si el dominio no es gmail, outlook, hotmail, live o msn:
# LCDS_SMTP_HOST=smtp.office365.com
# LCDS_SMTP_PORT=587

# WhatsApp automático (opcional). Sin esto, el POS abre wa.me para enviar a mano.
# Cuenta de WhatsApp Business / Meta: https://developers.facebook.com/docs/whatsapp/cloud-api
LCDS_WHATSAPP_TOKEN=
LCDS_WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada en Meta (header PDF + {{1}} folio + {{2}} total). Vacío = mensaje directo (solo ventana 24 h).
LCDS_WHATSAPP_TEMPLATE=
LCDS_WHATSAPP_TEMPLATE_LANG=es_MX
