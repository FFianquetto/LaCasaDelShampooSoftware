# Correo con el que salen los tickets. El cliente solo escribe su dirección en el ticket.
# Gmail, Outlook y Hotmail usan su servidor según el dominio. La contraseña es de aplicación.
LCDS_SMTP_USER=
LCDS_SMTP_PASS=
LCDS_SMTP_FROM=

# Solo si el dominio no es gmail, outlook, hotmail, live o msn:
# LCDS_SMTP_HOST=smtp.office365.com
# LCDS_SMTP_PORT=587
